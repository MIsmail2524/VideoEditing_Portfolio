# Copy to .env and adjust. Never commit .env.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Public URL of the site (used for canonical links, Open Graph and the CSRF origin check).
SITE_URL=https://www.example.com

# Keep true in production (requires HTTPS). Set false only for local http testing.
COOKIE_SECURE=true

# Set when running behind a reverse proxy / load balancer (nginx, Caddy, Render, Railway…).
# "1" = trust the first proxy hop. Leave empty when Node is exposed directly.
TRUST_PROXY=1

# Storage locations (relative to the project root or absolute).
DATA_DIR=data
# UPLOAD_DIR=data/uploads

# Upload limits
MAX_VIDEO_MB=500
MAX_IMAGE_MB=8

# Sessions
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12

# Brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Try to fetch TikTok / Vimeo cover images automatically.
FETCH_REMOTE_THUMBNAILS=true

# First start only: creates the admin if none exists. Remove afterwards
# (or use `npm run create-admin` instead).
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
